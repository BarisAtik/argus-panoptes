# Copy to .env and change every password. .env is git-ignored.

# --- Docker Compose ---------------------------------------------------------
ES_VERSION=9.5.5
ELASTIC_PASSWORD=change-me-elastic
KIBANA_PASSWORD=change-me-kibana
# Generate with: openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=change-me-to-32-or-more-random-characters
ES_HEAP=1g

# --- Beacon -----------------------------------------------------------------
ES_URL=http://localhost:9200
ES_USER=elastic
BEACON_INDEX=beacon-chunks
BEACON_BACKEND=elastic
# st:<sentence-transformers model> | onnx:<dir> | spacy:<model> | hash[:dims]
BEACON_EMBEDDER=st:intfloat/multilingual-e5-small
# Comma-separated access groups for this process. Unset means no access control.
# BEACON_GROUPS=public
BEACON_RRF_K=60

# --- Optional LLM for `beacon ask` (default generator needs neither) --------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
